@model List<baitapthemSession7.Models.Product>

<h1>Danh sách sản phẩm</h1>

<a asp-action="Create" class="btn btn-primary">
    Thêm sản phẩm
</a>

<br />
<br />

<table class="table table-bordered">

    <thead>
        <tr>
            <th>ID</th>
            <th>Tên</th>
            <th>Ảnh</th>
            <th>Giá</th>
            <th>Giá khuyến mãi</th>
            <th>Danh mục</th>
            <th>Chức năng</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>

                <td>@item.Name</td>

                <td>
                    <img src="~/@item.Image"
                         width="100"
                         height="100"
                         style="object-fit: cover;" />
                </td>

                <td>
                    @item.Price.ToString("N0")
                </td>

                <td>
                    @item.SalePrice.ToString("N0")
                </td>

                <td>
                    @{
                        var category = new[]
                        {
                            new { Id = 1, Name = "Điện thoại" },
                            new { Id = 2, Name = "Laptop" },
                            new { Id = 3, Name = "Phụ kiện" }
                        }
                        .FirstOrDefault(x => x.Id == item.CategoryId);
                    }

                    @category?.Name
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info">
                        Chi tiết
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning">
                        Sửa
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger">
                        Xóa
                    </a>

                </td>
            </tr>
        }

    </tbody>

</table>